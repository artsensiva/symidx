s = string!(.message)
if ends_with(s, "\r") { s = slice!(s, 0, -1) }
m, err = parse_regex(s, r'^(?P<label>[^ ]+) [0-9]+ [0-9]{4}\.[0-9]{2}\.[0-9]{2} (?P<node>[^ ]+) (?P<y>[0-9]{4})-(?P<mo>0[1-9]|1[0-2])-(?P<d>[0-9]{2})-(?P<h>[01][0-9]|2[0-3])\.(?P<mi>[0-5][0-9])\.(?P<se>[0-5][0-9])\.[0-9]{6} (?P<rest>.*)$')
if err != null { abort }
if m.d == "00" || to_int!(m.d) > 31 { abort }
rest = string!(m.rest)
if !(m.node == "-" && (starts_with(rest, "RAS ") || starts_with(rest, "NULL "))) {
  t, e = parse_regex(rest, r'^[^ ]+ (?P<r>.*)$')
  if e != null { abort }
  rest = string!(t.r)
}
x, e2 = parse_regex(rest, r'^(RAS|NULL) (?P<c>[^ ]+) (?P<l>INFO|WARNING|ERROR|SEVERE|FATAL|FAILURE)( (?P<msg>.*))?$')
if e2 != null { abort }
msg = if x.msg == null { "" } else { string!(x.msg) }
component = string!(x.c)
ts = join!([m.y, "-", m.mo, "-", m.d, "T", m.h, ":", m.mi, ":", m.se, "Z"])
level = string!(get!({"INFO":"INFO","WARNING":"WARN","ERROR":"ERROR","SEVERE":"ERROR","FATAL":"FATAL","FAILURE":"FATAL"}, [x.l]))
kv = {"node": m.node}
if m.label != "-" { kv = set!(kv, ["alert"], m.label) }
# Filter by level.
rank = int!(get!({"TRACE":0,"DEBUG":1,"INFO":2,"NOTICE":3,"WARN":4,"ERROR":5,"FATAL":6}, [level]))
min = if component == "dfs.DataNode$PacketResponder" || component == "dfs.FSDataset" { 4 } else if component == "APP" { 5 } else { 2 }
if rank < min {
  . = {"sanitize_filtered": true}
} else {

# Redact. A run can't be matched with lookaround in VRL's regex engine, and a match consumes the byte after it,
# so two passes are needed for addresses separated by one byte.
red = replace(msg, r'(^|[^0-9.])[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(\.*)($|[^0-9.])', "$1<ip>$2$3")
red = replace(red, r'(^|[^0-9.])[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(\.*)($|[^0-9.])', "$1<ip>$2$3")
if contains(red, "0x") {
  red = replace(red, r'(^|[^0-9A-Za-z])0x[0-9a-fA-F]{8}($|[^0-9A-Za-z])', "$1<hex>$2")
  red = replace(red, r'(^|[^0-9A-Za-z])0x[0-9a-fA-F]{8}($|[^0-9A-Za-z])', "$1<hex>$2")
}

# Message pairs: a key keeps the value of its last occurrence.
if contains(red, "=") {
  for_each(split(red, " ")) -> |_i, tok| {
    if contains(tok, "=") {
      p, e = parse_regex(tok, r'^(?P<k>[A-Za-z0-9_.-]+)=(?P<v>.*)$')
      if e == null { kv = set!(kv, [p.k], p.v) }
    }
  }
}

sev = int!(get!({"FATAL":2,"ERROR":3,"WARN":4,"NOTICE":5,"INFO":6,"DEBUG":7,"TRACE":7}, [level]))
. = {"ts": ts, "level": level, "sev": sev, "component": component, "msg": red, "kv": kv}
}
